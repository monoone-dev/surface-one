{
  "name": "@surface-one/tokens",
  "version": "0.13.1",
  "description": "SurfaceOne design tokens, skins (Studio, Paper, Minimalist, Neumorphism, Material, Surface × light/dark), accents and latin-ext fonts — framework-agnostic CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monoone-dev/surface-one.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "css/index.css",
  "exports": {
    ".": "./css/index.css",
    "./css/*": "./css/*",
    "./scss/*": "./src/*",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "css",
    "dist",
    "src",
    "fonts",
    "brand"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check && node --test test/*.test.mjs",
    "test:update": "node test/update-snapshot.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
