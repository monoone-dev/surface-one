{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["node"],
    // The playground imports the package by name; type-check it against the sources,
    // not dist/ (which a fresh checkout has not built yet).
    "paths": {
      "@surface-one/vue": ["./src/index.ts"]
    }
  },
  "vueCompilerOptions": {
    // Attributes and listeners fall through to the rendered element (`href`, `@click`,
    // `aria-label`), so only unknown components are errors, not unknown props.
    "checkUnknownComponents": true,
    "checkUnknownDirectives": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue"
  ]
}
