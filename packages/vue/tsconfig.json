{
  "extends": "../core/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node", "@angular/localize", "vite/client"],
    // The playground imports the package by name; type-check it against the sources,
    // not dist/ (which a fresh checkout has not built yet). Core is bundled from its
    // sources; the Angular flow types name their icons through the core shim.
    "paths": {
      "@surface-one/vue": ["./src/index.ts"],
      "@surface-one/core": ["../core/src/index.ts"],
      "@surface-one/angular/icon": ["../core/src/angular-icon.ts"],
      "@surface-one/angular/format": ["../angular/format/index.ts"]
    }
  },
  "vueCompilerOptions": {
    // Attributes and listeners fall through to the rendered element (`href`, `@click`,
    // `aria-label`), so only unknown components are errors, not unknown props.
    "checkUnknownComponents": true,
    "checkUnknownDirectives": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    // The Vue twins of the docs templates and demos, type-checked against the sources.
    "../../apps/docs/src/app/templates/vue/*.vue",
    "../../apps/docs/src/app/demos/vue/*.vue"
  ]
}
