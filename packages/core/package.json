{
  "name": "@surface-one/core",
  "version": "0.0.0",
  "private": true,
  "description": "SurfaceOne internals shared by @surface-one/vue and @surface-one/react — framework-agnostic TypeScript, bundled into both, never published.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node ../../scripts/generate-icons.mjs src/icons.generated.ts",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run generate && vitest run"
  }
}
