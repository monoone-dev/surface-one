{
  "extends": "../core/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "@angular/localize", "vite/client"],
    // The playground and the docs templates import the package by name; type-check them
    // against the sources, not dist/ (which a fresh checkout has not built yet). Core is
    // bundled from its sources; the Angular flow types name their icons through the
    // core shim.
    "paths": {
      "@surface-one/react": ["./src/index.ts"],
      "@surface-one/core": ["../core/src/index.ts"],
      "@surface-one/angular/icon": ["../core/src/angular-icon.ts"],
      "@surface-one/angular/format": ["../angular/format/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    // The React twins of the docs templates, type-checked against the sources.
    "../../apps/docs/src/app/templates/react/*.tsx"
  ]
}
