{
  "name": "@surface-one/react",
  "version": "0.28.0",
  "description": "SurfaceOne design system — React 19 and Next.js components with the Sone prefix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monoone-dev/surface-one.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "nextjs",
    "design-system",
    "components",
    "surface-one"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node ../../scripts/generate-host-css.mjs src/styles/hosts.generated.css && node ../../scripts/build-template-sources.mjs",
    "build": "npm run generate && vite build && node ../core/config/component-css.mjs && tsc -p tsconfig.build.json && node ../core/config/link-dts.mjs",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "playground": "npm run generate && vite --config playground/vite.config.ts",
    "test": "npm run generate && vitest run"
  },
  "peerDependencies": {
    "@surface-one/tokens": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.7.0",
    "dompurify": "^3.4.0",
    "marked": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@lezer/markdown": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "marked": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
