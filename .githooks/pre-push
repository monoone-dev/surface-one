#!/bin/sh
# Before a push, the fast checks CI would fail on (each takes seconds):
#   branch name <type>/<kebab-slug> (validate-branch-name in package.json),
#   formatting (prettier --check), the design-token style lint (stylelint) and eslint.
set -e
npx --no-install validate-branch-name
npm run -s format:check
npm run -s lint:styles
npm run -s lint
