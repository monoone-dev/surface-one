{
  "name": "surface-one",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true; node scripts/build-ai.mjs",
    "start": "ng serve docs",
    "build": "npm run build:tokens && npm run build:lib && npm run build:docs",
    "build:tokens": "npm run build -w @surface-one/tokens",
    "build:lib": "ng build angular",
    "build:docs": "npm run docs:api && npm run ai:build && ng build docs && node scripts/postbuild-docs.mjs",
    "build:site": "npm run build && npm run build-storybook && node scripts/merge-storybook.mjs",
    "docs:api": "node scripts/extract-api.mjs",
    "storybook": "ng run angular:storybook",
    "build-storybook": "ng run angular:build-storybook",
    "test:a11y": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run docs:api && ngc -p apps/docs/tsconfig.check.json",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "lint:branch": "validate-branch-name",
    "ai:build": "node scripts/build-ai.mjs",
    "test:mcp": "npm test -w @surface-one/angular-mcp",
    "release:version": "node scripts/release-version.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2",
    "@angular/build": "22.2",
    "@angular/cli": "22.2",
    "@angular/common": "22.2",
    "@angular/compiler": "22.2",
    "@angular/compiler-cli": "22.2",
    "@angular/core": "22.2",
    "@angular/forms": "22.2",
    "@angular/localize": "22.2",
    "@angular/platform-browser": "22.2",
    "@angular/platform-browser-dynamic": "22.2",
    "@angular/platform-server": "22.2",
    "@angular/router": "22.2",
    "@angular/ssr": "22.2",
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@types/node": "^22.12.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.0",
    "marked": "^18.1.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.9",
    "rxjs": "^7.8.2",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "validate-branch-name": "^1.3.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@angular/platform-server": "22.2",
    "@angular/ssr": "^22.2.1"
  },
  "validate-branch-name": {
    "pattern": "^(main|dependabot/.+|release/.+|(feat|fix|refactor|chore|docs|test|perf|ci|build|style|revert)/[a-z0-9._-]+)$",
    "errorMsg": "Branch must be <type>/<kebab-slug>, e.g. feat/sone-calendar (types: feat fix refactor chore docs test perf ci build style revert). Rename it with: git branch -m <type>/<slug>"
  }
}
